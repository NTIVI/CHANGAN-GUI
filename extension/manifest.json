{
  "manifest_version": 3,
  "name": "CHANGAN.AM — Возврат на экран",
  "version": "1.0.0",
  "description": "Плавающая кнопка на всех сайтах для мгновенного возврата в автомобильный портал CHANGAN.AM",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "CHANGAN.AM Portal",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
